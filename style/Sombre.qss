QWidget {
    background-color: #000000;
}

/* -----------[ BANDEAU !! ]----------- */

QMenuBar {
    font-family: "Nunito";
    font-size: 14px;
    background-color: #444444;
}

QMenuBar::item:selected, QMenuBar::item:hover {
    background-color: #3399FF;
    color: #FFFFFF;
}

QMenu {
    font-family: "Nunito";
    font-size: 14px;
    background-color: #444444;
    color: #FFFFFF;
}

QMenu::item:selected, QMenu::item:hover {
    background-color: #3399FF;
    color: #FFFFFF;
}


/* Sert aussi dans plan.py */
QMessageBox {
    font-family: "Nunito";
    font-size: 14px;
}

/* -----------[ INFORMATIONS !! ]----------- */

/* Sert aussi dans listeProduitCase.py */
QLabel {
    font-family: "Nunito";
    font-size: 18px;
    color: #FFFFFF;
    
}

QLabel#produits {
    font-size: 14px;
    color: #FFFFFF;
}

QLineEdit {
    font-family: "Nunito";
    font-size: 14px;
    color: #FFFFFF;
    text-transform: normal;
}

/* -----------[ PLAN !! ]----------- */

QPushButton#image {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    font-family: "Nunito";
    font-size: 14px;
    color: #FFFFFF;
}

QPushButton#image:hover {
    background-color: #1f1f1f;
    color: #d4d4d4;
    border: 1.5px solid #FFFFFF;
}

/* Les QPushButton basiques sont utilisés pour chaque flèche directionnelle */

QPushButton {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    font-family: "Nunito";
    font-size: 14px;
    color: #FFFFFF;
    padding: 3px 5px;
}

QPushButton:hover {
    background-color: #1f1f1f;
    color: #d4d4d4;
    border: 1.5px solid #FFFFFF;
}

QPushButton:pressed {
    background-color: #B0B0B0;
    padding-top: -15px;
    padding-bottom: -17px;
}

QSlider::groove:horizontal {
    border: 1px solid #bbb;
    background: #4f4f4f; 
    height: 6px;
    border-radius: 3px;
    margin: 0 8px;
}

QSlider::sub-page:horizontal {
    border: 1px solid #444444;
    background: #3399FF; 
    height: 6px;
    border-radius: 3px;
    margin: 0 8px;
}

QSlider::handle:horizontal {
    border: none;
    width: 14px;
    height: 14px;
    border-radius: 2px; 
    margin: -4px 0;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.4);
    background-color: #2b2b2b;
}



/* -----------[ Pop up !! ]----------- */

QMessageBox QPushButton {
    padding: 4px 12px;
    margin: 0 6px;
}