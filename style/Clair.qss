"files.associations": {
    "*.qss": "css"
}


/* -----------[ BANDEAU !! ]----------- */

QMenuBar {
    background-color : #505050;
}

QMenu {
    font-family : "Nunito";
    font-size : 14px;
}

/* MAYBE A FAIRE MAIS MAYBE NON !! Noa a dit que c'était okay sans style
QAction {

}
*/

/* Sert aussi dans plan.py */
QMessageBox {
    font-family : "Nunito";
    font-size : 14px;
}

/* -----------[ ELEMENTS MAGASIN!! ]----------- */

QPushButton#mur {
    background-color : #C8C8C8;
    border : 1px solid #000000;
    font-family : "Nunito";
    font-size : 14px;
}

QPushButton#mur : hover {
    background-color : #A0A0A0;
    color : #2b2b2b;
    border : 1.5px solid #000000;
}

QPushButton#caisse {
    background-color : #FF4C4C;
    border : 1px solid #000000;
    font-family : "Nunito";
    font-size : 14px;
}

QPushButton#caisse : hover {
    background-color : #CC3C3C;
    color : #2b2b2b;
    border : 1.5px solid #000000;
}

QPushButton#entree {
    background-color : #81E8FF;
    border : 1px solid #000000;
    font-family : "Nunito";
    font-size : 14px;
}

QPushButton#entree : hover {
    background-color : #52BBD9;
    color : #2b2b2b;
    border : 1.5px solid #000000;
}

/* -----------[ INFORMATIONS !! ]----------- */

/* Sert aussi dans listeProduitCase.py */
QLabel {
    font-family : "Nunito";
    font-size : 18px;
}

QLineEditParDefaut {
    font-family : "Nunito";
    font-size : 18px;
}

/* Sert aussi dans listeProduitCase.py (fermer) et plan.py (-)*/
QPushButton#fermer {
    background-color : #FF9A9A;
    border : 1px solid #000000;
}

QPushButton#fermer : hover {
    background-color : #D47474;
    color : #2b2b2b;
    border : 1.5px solid #000000;
}

/* -----------[ PLAN !! ]----------- */

QPushButton#image {
    background-color : #ffffff;
    border : 1px solid #000000;
    font-family : "Nunito";
    font-size : 14px;
}

QPushButton#image : hover {
    background-color : #e0e0e0;
    color : #2b2b2b;
    border : 1.5px solid #000000;
}

QPushButton#plus {
    background-color : #C0FF9E
    border : 1px solid #000000;
}

QPushButton#plus : hover {
    background-color : #98D97F
    color : #2b2b2b;
    border : 1.5px solid #000000;
}

/* Les QPushButton basiques sont utilisés pour chaque flèche directionnelle */

QPushButton {
    background-color : #ffffff;
    border : 1px solid #000000;
    font-family : "Nunito";
    font-size : 14px;
}

QPushButton : hover {
    background-color : #e0e0e0;
    color : #2b2b2b;
    border : 1.5px solid #000000;
}

QPushButton : pressed {
    background-color: #B0B0B0;
    padding-top: -15px;
    padding-bottom: -17px;
}

QSlider::handle:horizontal {
    border: none;
    width: 14px;
    height: 14px;
    border-radius: 2px; 
    margin: -4px 0;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.4);
}

/* -----------[ A GARDER POUR L'INSTANT !! ]----------- */

QPushButton {
    background-color : #ffffff;
    border : 1px solid #000000;
    font-family : "Nunito";
    font-size : 14px;
}

QPushButton : hover {
    background-color : #e0e0e0;
    color : #2b2b2b;
    border : 1.5px solid #000000;
}